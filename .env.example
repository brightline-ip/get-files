# Get Files reads these from the process environment (it does not load .env files itself).
# Set them in your shell profile, a launcher, or the "env" block of your MCP client configuration.
# All are optional; the values below are placeholders showing the format.

# Directory for the library, database, service token and logs (default: <install dir>\data)
GET_FILES_DATA=C:\Users\YOU\AppData\Local\GetFiles\data

# Folder that "output_dir" / --output exports are confined to (default: <Documents>\Get Files)
GET_FILES_EXPORT_ROOT=C:\Users\YOU\Documents\Get Files

# Service URL and token file used by the Node client and MCP server (defaults shown)
GET_FILES_URL=http://127.0.0.1:8766
GET_FILES_TOKEN_FILE=C:\Users\YOU\AppData\Local\GetFiles\data\service-token.txt

# Set to false so the Node client / MCP server never starts the service itself (default: true)
GET_FILES_AUTOSTART=true

# Python interpreter used by start.ps1 / corpus.ps1 (default: <install dir>\.venv\Scripts\python.exe)
GET_FILES_PYTHON=C:\path\to\python.exe

# Tests only: Context Forge checkout to compare the vendored OCR adapter against (test skipped if unset)
GET_FILES_CONTEXT_FORGE_DIR=
# Tests only: set to 1 to run the timing-dependent 66-page Windows OCR test
GET_FILES_SLOW_OCR_TESTS=

# Set to 1 to accept requests addressed to host.docker.internal (a client running in Docker Desktop,
# such as the Research Verification Workbench container). The bearer token is still required. Default: off.
GET_FILES_ALLOW_DOCKER_HOST=
